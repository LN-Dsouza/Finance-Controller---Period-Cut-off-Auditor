# Database (SQLite default for local demo; Postgres when using docker compose)
DATABASE_URL=sqlite:///./backend/data/database.db
# DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_controller

# LLM (provide at least one)
LLM_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-finance-controller
LANGCHAIN_TRACING_V2=false

# API
HOST=127.0.0.1
PORT=8000
